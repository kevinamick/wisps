# Copy to deploy/wisps.env (not committed) and adjust. Read by the systemd service.
# Extra host names the web app may be reached by, e.g. a Tailscale name for `tailscale serve`:
# ALLOWED_HOSTS=my-server.tailnet-name.ts.net
# PORT=4777
# WISPS_DATA=/path/to/data
# WISPS_MAX_PARALLEL=3
# Port friends' Wisps use to reach this one (serves only /peer/*, never the app). Expose only this port to friends.
# PEER_PORT=4778
